diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index dd81949..f4e7160 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -1146,6 +1146,12 @@ OPENSSL_EXPORT int SSL_set_ocsp_response(SSL *ssl, const uint8_t *response,
 #define SSL_SIGN_RSA_PSS_RSAE_SHA512 0x0806
 #define SSL_SIGN_ED25519 0x0807
 
+// SSL_SIGN_MLDSA* are the TLS 1.3 ML-DSA signature schemes
+// (draft-ietf-tls-mldsa). Chromium offers them ahead of the classical schemes.
+#define SSL_SIGN_MLDSA44 0x0904
+#define SSL_SIGN_MLDSA65 0x0905
+#define SSL_SIGN_MLDSA87 0x0906
+
 // SSL_SIGN_RSA_PKCS1_SHA256_LEGACY is a backport of RSASSA-PKCS1-v1_5 with
 // SHA-256 to TLS 1.3. It is disabled by default and only defined for client
 // certificates.
diff --git a/ssl/ssl_privkey.cc b/ssl/ssl_privkey.cc
index 926d2c0..71362e2 100644
