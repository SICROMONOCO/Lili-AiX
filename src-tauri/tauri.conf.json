{
  "productName": "Anilili",
  "version": "0.1.6",
  "identifier": "app.anilili.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["anilili"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/libmpv/win32-x64/libmpv-2.dll": "libmpv-2.dll",
      "../vendor/libmpv/win32-x64/vulkan-1.dll": "vulkan-1.dll",
      "../vendor/libmpv/win32-x64/VulkanRT-License.txt": "licenses/VulkanRT-License.txt",
      "../vendor/shaders/": "shaders/",
      "../vendor/providers/": "providers/",
      "../vendor/filters/": "filters/"
    }
  }
}
